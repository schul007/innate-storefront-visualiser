# ---- Copy to .env and fill in. .env is gitignored. ----

# Google Maps Platform key with BOTH enabled:
#   - Places API (New)            -> venue discovery
#   - Street View Static API      -> frontage capture
# Create at https://console.cloud.google.com/ (billing must be enabled, but the
# free monthly tier covers prototype volume). Restrict the key to those APIs.
GOOGLE_MAPS_API_KEY=

# Google AI Studio (Gemini) key -> vision judge + "Nano Banana" compositing.
# Free tier, no billing needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional free fallback for street imagery when Street View coverage is poor.
# Get a token at https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Optional model overrides (defaults are sensible).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_VISION_MODEL=gemini-2.5-flash
